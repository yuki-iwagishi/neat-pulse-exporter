# Server port (optional, default: 3000)
PORT=3000

# Bind address (use 127.0.0.1 for local-only, 0.0.0.0 for network access)
HOST=127.0.0.1

# Maximum concurrent requests to the Pulse API (default: 3)
# Raise to 5 only if you are on a small tenant (<50 devices).
# Large tenants (200+ devices) may hit 429 rate limits above 3.
CONCURRENCY=3

# Optional: pre-fill API credentials so they don't need to be typed in the UI.
# Leave empty to require entry in the browser form.
# WARNING: never commit a real .env file. Use .env locally only.
PULSE_API_KEY=
PULSE_ORG_ID=
